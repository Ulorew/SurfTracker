// ---- ВТОРОЙ ТРАКТ: аппаратный захват TIM2 на PA15 --------------------------
//
// Читается ВСЕГДА, но в управлении и телеметрии НЕ УЧАСТВУЕТ — только в
// диагностике. Цена чтения два регистра, поэтому держать его включённым
// дешевле, чем заводить отдельную прошивку ради сравнения.
//
// PA15 это TIM2_CH1 (проверено по PeripheralPins ядра 2.10.1), а SENSOR_PIN
// PB8 — TIM4_CH3. Режим PWM input работает только от TI1/TI2, поэтому
// аппаратный захват возможен именно на PA15 и невозможен на PB8. Энкодер
// запаян на оба пина: один выход на два высокоомных входа.
static void captureBegin() {
  __HAL_RCC_GPIOA_CLK_ENABLE();
  __HAL_RCC_TIM2_CLK_ENABLE();
  // PA15 после сброса отдан под JTDI. Отладке по SWD (PA13/PA14) это не
  // мешает, но пин надо явно перевести в AF1 = TIM2_CH1.
  GPIO_InitTypeDef g = {0};
  // ПОДТЯЖКА ВВЕРХ, а не NOPULL: после сброса на PA15 подтяжка есть, а провод
  // общий с PB8 — сняв её, мы изменили бы условия на узле для ОБОИХ трактов и
  // сравнивали бы уже не способы чтения, а разные электрические режимы.
  g.Pin = GPIO_PIN_15; g.Mode = GPIO_MODE_AF_PP; g.Pull = GPIO_PULLUP;
  g.Speed = GPIO_SPEED_FREQ_HIGH; g.Alternate = GPIO_AF1_TIM2;
  HAL_GPIO_Init(GPIOA, &g);
  // Каналы и подчинённый режим ГАСЯТСЯ ПЕРЕД настройкой: поля CC1S/CC2S
  // записываемы только при выключенном канале (CCxE = 0).
  TIM2->CR1 = 0; TIM2->CCER = 0; TIM2->SMCR = 0;
  TIM2->PSC = 0; TIM2->ARR = 0xFFFFFFFF;
  TIM2->CCMR1 = (1u << 0) | (2u << 4) | (2u << 8) | (2u << 12);
  TIM2->CCER  = TIM_CCER_CC1E | TIM_CCER_CC2E | TIM_CCER_CC2P;
  TIM2->SMCR  = (5u << TIM_SMCR_TS_Pos) | (4u << TIM_SMCR_SMS_Pos);
  TIM2->CR1  |= TIM_CR1_CEN;
}

// ---- ПРИЗНАКИ В БАЙТЕ flags ПАКЕТА DIAG ------------------------------------
//
// Раскладка пакета НЕ ТРОНУТА: байт flags как был один (смещение 22), так и
// остался, длина DIAG прежние 27 байт. Изменился СМЫСЛ бита 2 и заняты два
// свободных бита из четырёх.
//
// ОБЪЯВЛЕНЫ ОНИ В ОБЩЕМ ЗАГОЛОВКЕ SurfProtoV2 — там же, откуда их берёт хост,
// и там же записано, что каждый бит значит. Дублировать их здесь нельзя: имя
// и номер бита обязаны иметь ровно одно место, иначе правят одну копию, а
// исполняется другая. До этой правки они жили в ТРЁХ местах сразу — в
// прошивке, в proto_v2.py и голыми числами в diag_metrics.py.
using proto::DF_CAP_BAD;
using proto::DF_ISR_BAD;
using proto::DF_CAP_SKIP;
using proto::DF_NO_EDGES;
using proto::DF_CAP_STALL;
using proto::DF_CAP_PREV;

/**
 * Снимок тракта захвата. Все величины — тики TIM2.
 *
 *  period/high — период и ширина импульса ОДНОГО И ТОГО ЖЕ кадра;
 *  age         — возраст ИМЕННО ЭТОГО отсчёта (с поправкой, см. ниже);
 *  skipped     — CC1OF: кадры между чтениями пропускались (на 50 Гц норма);
 *  stalled     — поток кадров ВСТАЛ, это и есть «датчик мёртв»;
 *  prev_frame  — импульс взят из предыдущего кадра, возраст увеличен на период.
 *
 * Возвращает true, если пара годна И поток кадров жив.
 */
static bool captureRead(uint32_t *period, uint32_t *high, uint32_t *age,
                         bool *skipped, bool *stalled, bool *prev_frame) {
  // СНИМОК БЕРЁТСЯ МЕЖДУ ДВУМЯ ЧТЕНИЯМИ CNT. TIM2 стоит в режиме сброса, то
  // есть CNT обнуляется каждым нарастающим фронтом; значит cnt1 < cnt0
  // означает, что фронт пришёл ПРЯМО ВО ВРЕМЯ снимка и регистры прочитаны по
  // разные стороны границы кадра. Такой снимок отбрасывается целиком: чинить
  // его нечем, а принять молча — внести ошибку в целый кадр.
  const uint32_t cnt0 = TIM2->CNT;
  const uint32_t sr   = TIM2->SR;
  const uint32_t h    = TIM2->CCR2;      // чтение снимает CC2IF
  const uint32_t p    = TIM2->CCR1;
  const uint32_t cnt1 = TIM2->CNT;
  const bool torn = (cnt1 < cnt0);

  // ---- ПОЧЕМУ ЗДЕСЬ БОЛЬШЕ НЕТ ПРОВЕРКИ ПО CC2IF --------------------------
  //
  // Стояло `paired = (sr & TIM_SR_CC2IF) != 0` с длинным объяснением, что так
  // ловится смесь «импульс нового кадра, период старого». Проверка была
  // ТОЖДЕСТВЕННО ИСТИННОЙ и не отвергла ни одного пакета за всё время:
  // CC2IF взводится КАЖДЫМ спадом и снимается только нашим чтением CCR2, а
  // между двумя чтениями проходит около двадцати кадров, то есть около
  // двадцати спадов. К моменту снимка бит стоял всегда, при любом угле и на
  // любом валу. Условие выглядело проверкой и ею не было — вернуть его значит
  // вернуть пустое место.
  //
  // ---- ЧТО СТОИТ ВМЕСТО НЕГО ----------------------------------------------
  //
  // CNT — тики от начала ТЕКУЩЕГО кадра. Спад текущего кадра наступает через
  // h тиков после его начала. Значит импульс ТЕКУЩЕГО кадра защёлкнут в CCR2
  // тогда и только тогда, когда возраст БОЛЬШЕ ширины импульса. Сравниваются
  // две величины из одного и того же кадра, а не история наших чтений,
  // поэтому проверка одинаково работает и на 5 Гц опроса, и на 5 кГц.
  //
  // Берётся cnt0, прочитанный ДО CCR2: он заведомо не больше настоящего
  // возраста в момент защёлкивания, поэтому ошибка сдвигает решение в сторону
  // «импульс старый», то есть в сторону поправки, а не тихого принятия смеси.
  // Остаётся окно в единицы тактов — спад пришёлся между чтением CNT и
  // чтением CCR2, это порядка 1e-5 снимков, и другого способа его закрыть на
  // этом таймере нет.
  const bool cur_frame = (cnt0 > h);

  // ---- ОТСТАВАНИЕ НА КАДР ЗАКРЫВАЕТСЯ ПОПРАВКОЙ, А НЕ ОТКАЗОМ -------------
  //
  // Если спад текущего кадра ещё не наступил, в CCR2 лежит импульс
  // ПРЕДЫДУЩЕГО кадра — а в CCR1 лежит длительность ровно того же предыдущего
  // кадра (CCR1 обновился на границе, до спада обновиться нечему). Пара сама
  // по себе согласована, скважность из неё считается верно. Неверен только
  // ВОЗРАСТ: отсчёт старше на целый кадр — 921 мкс, то есть 0.016 град при
  // 0.3 рад/с. Поэтому снимок не выбрасывается, а получает честный возраст
  // cnt0 + p, и хост, вычитающий cap_age из t_us, ставит его на шкалу времени
  // туда, где он действительно был снят.
  //
  // ВЫБРАСЫВАТЬ БЫЛО БЫ ХУЖЕ, ЧЕМ НЕ ПРОВЕРЯТЬ. Доля таких снимков равна
  // скважности, а скважность — это и есть измеряемый угол: отказ был бы
  // систематически связан с измеряемой величиной, и у верхнего края диапазона
  // тракт ослеп бы почти полностью. Факт поправки уходит отдельным битом,
  // чтобы её было видно снаружи.
  if (age) *age = cur_frame ? cnt0 : (cnt0 + p);
  if (prev_frame) *prev_frame = !cur_frame;

  // ---- ЖИВ ЛИ ПОТОК КАДРОВ ------------------------------------------------
  //
  // Ровно то, чего не умели ни CC1OF, ни проверка по CC2IF. На замершем
  // датчике регистры сохраняют последние значения, период остаётся в допуске,
  // ширина тоже — и МЁРТВЫЙ ТРАКТ ВЫГЛЯДИТ ИСПРАВНЫМ. Признаков два, и они
  // ловят два разных отказа.
  //
  // Признак 1: CNT растёт и не обнуляется. Возраст больше двух кадров значит,
  // что нарастающих фронтов нет — датчик молчит. Мера берётся из самих данных
  // (период того же кадра), поэтому темп опроса роли не играет; сравнение
  // сделано сдвигом, чтобы 2*p не переполнило 32 бита на мусорном периоде.
  //
  // Признак 2: не двигалось ВООБЩЕ НИЧЕГО — ни CNT, ни CCR1, и переполнения
  // не было. Так выглядит ОСТАНОВЛЕННЫЙ таймер: сбитая настройка PA15, снятое
  // тактирование, невызванный captureBegin(). Возраст при этом мал, и первый
  // признак молчит. На живом тракте CNT тикает 170 миллионов раз в секунду,
  // поэтому два подряд одинаковых чтения означают ровно одно.
  static uint32_t cnt_prev = 0, period_prev = 0;
  const bool overflow = (sr & TIM_SR_CC1OF) != 0;
  const bool frozen = (cnt0 == cnt_prev) && (p == period_prev) && !overflow;
  const bool stall  = (p == 0) || ((cnt0 >> 1) > p) || frozen;
  cnt_prev = cnt0; period_prev = p;

  // CC1OF чтением CCR1 НЕ снимается, поэтому сбрасывается явно: иначе он
  // залипнет навсегда и перестанет значить даже то немногое, что значит —
  // «с прошлого DIAG пришло не меньше двух нарастающих фронтов».
  if (skipped) *skipped = overflow;
  if (stalled) *stalled = stall;
  TIM2->SR = ~TIM_SR_CC1OF;

  *period = p; *high = h;
  // ЖИВОСТЬ ВХОДИТ В ГОДНОСТЬ. Раньше на мёртвом датчике cap_ok оставался
  // истинным: период и ширина замирали внутри допуска, проверка пары была
  // тождественно истинна, и признак негодности не срабатывал ни разу.
  return !torn && !stall && (p > 136000UL) && (p < 212500UL)
         && (h > 0) && (h < p);
}

